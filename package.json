{
  "name": "siteops-platform",
  "version": "1.0.0",
  "description": "SiteOps Construction Management Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "backend\\.venv\\Scripts\\python.exe backend\\manage.py runserver 8000",
    "seed": "backend\\.venv\\Scripts\\python.exe backend\\manage.py seed_siteops_demo",
    "test:backend": "backend\\.venv\\Scripts\\python.exe backend\\manage.py test apps.core",
    "build:frontend": "npm --prefix frontend run build",
    "mobile": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "debug:wireless": "scripts\\wireless-debug.bat",
    "mobile:wireless": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\wireless_debug.ps1 -Action run-android",
    "mobile:start:lan": "npm --prefix mobile run start:lan",
    "frontend:lan": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "backend:lan": "backend\\.venv\\Scripts\\python.exe backend\\manage.py runserver 0.0.0.0:8000"
  }
}
